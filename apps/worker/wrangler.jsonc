// Конфиг для локальной разработки (`npm run dev:worker`).
// Боевые конфиги клиентов будут генерироваться из clients/<slug>/client.jsonc (этап 5).
{
  "name": "vitrina-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../miniapp/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/bot", "/admin/*", "/cron"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "vitrina-dev-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "MEDIA", "id": "00000000000000000000000000000000" }],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "BOT_USERNAME": "perekup_shop_bot",
    "PUBLIC_READ": "1"
  }
  // Секреты: .dev.vars локально, `wrangler secret put` в бою — BOT_TOKEN, ADMIN_IDS, WEBHOOK_SECRET, ADMIN_API_KEY, GEMINI_API_KEY
}
