{
  "name": "vitrina",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:app": "vite --config apps/miniapp/vite.config.ts",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc",
    "build": "vite build --config apps/miniapp/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/worker/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "lottie-web": "^5.13.0",
    "preact": "^10.29.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.152.0"
  }
}
